[Unit]
Description=Pin the OBS Virtual Camera loopback format before PipeWire probes it
# Started by etc/udev/rules.d/90-obs-virtual-camera.rules when /dev/video10 appears.
# Must match the OBS canvas/output settings (1920x1080 @ 60 fps, YUYV is what
# OBS's v4l2loopback output uses). Change here if the OBS profile changes.
ConditionPathExists=/dev/video10

[Service]
Type=oneshot
ExecStart=/usr/bin/v4l2loopback-ctl set-caps /dev/video10 YUYV:1920x1080@60/1
